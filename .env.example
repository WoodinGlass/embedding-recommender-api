# =============================================================================
# embedding-recommender-api — example configuration
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.
# Every variable here is documented in docs/contracts.md § 3.1.
# =============================================================================

# --- application ---------------------------------------------------------
APP_ENV=dev                       # dev | staging | prod
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | console
METRICS_ENABLED=true

# --- storage: PostgreSQL with pgvector -----------------------------------
DATABASE_URL=postgresql://recsys:recsys@postgres:5432/recsys

# --- cache: Redis --------------------------------------------------------
# The cache is optional on the hot path — the service degrades gracefully
# if Redis is unreachable (docs/adr/0015-cache-and-circuit-breaker.md).
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# --- authentication (ADR-0013) -------------------------------------------
# API_KEYS is a comma-separated list of Argon2id hashes.
# In production, every key is hashed; the plaintext is never in the file.
# For development the values below are plaintext, which is fine only
# because the dev environment has no real callers.
API_KEYS=dev-key-1,dev-key-2
# API_KEYS_ADMIN is empty by default; admin operations are for M6.
API_KEYS_ADMIN=
JWT_SECRET=change-me-before-any-real-deployment-min-32-chars
JWT_ALGORITHM=HS256
JWT_MAX_AGE_SECONDS=86400

# --- rate limiting (ADR-0014) --------------------------------------------
# Per-class limits live in config/hot.yaml. This value is the default for a
# class the hot config does not override.
RATE_LIMIT_PER_MINUTE=600
# The number of running API instances; used to split the limit when the
# per-instance fallback limiter is active (Redis unreachable).
INSTANCE_COUNT=1

# --- circuit breakers (ADR-0015) -----------------------------------------
REDIS_BREAKER_FAILURE_THRESHOLD=5
REDIS_BREAKER_OPEN_SECONDS=5
REDIS_BREAKER_OPEN_MAX_SECONDS=60
REDIS_BREAKER_TIMEOUT_SECONDS=0.1
DB_BREAKER_FAILURE_THRESHOLD=5
DB_BREAKER_OPEN_SECONDS=2
DB_BREAKER_OPEN_MAX_SECONDS=30
DB_BREAKER_TIMEOUT_SECONDS=2.0

# --- event ingestion (ADR-0018) ------------------------------------------
EVENT_TS_MAX_AGE_SECONDS=604800
EVENT_TS_MAX_FUTURE_SECONDS=300
# USER_ID_HASH_SALT is a secret: keep it out of git and out of logs.
# The version bumps when the salt rotates.
USER_ID_HASH_SALT=change-me-before-any-real-deployment
USER_ID_HASH_SALT_VERSION=0
EVENT_RETENTION_DAYS=365

# --- readiness (ADR-0019) ------------------------------------------------
READYZ_CACHE_SECONDS=5
READYZ_DB_TIMEOUT_SECONDS=0.5
READYZ_INDEX_TIMEOUT_SECONDS=0.5
READYZ_REDIS_TIMEOUT_SECONDS=0.1

# --- observability (ADR-0021) --------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=recsys-api
OTEL_TRACES_SAMPLER_ARG=1.0

# --- config pollers (ADR-0022) -------------------------------------------
HOT_CONFIG_POLL_SECONDS=5
ACTIVE_INDEX_POLL_SECONDS=10

# --- embeddings ----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_ONNX_PATH=artifacts/onnx/sentence-transformers__all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
DEVICE=cpu                        # cpu | cuda

# --- retrieval -----------------------------------------------------------
INDEX_BACKEND=pgvector            # pgvector | faiss
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=100
ANN_TIMEOUT_MS=120                # hard timeout before serving the fallback

# --- deployment (ADR-0023) -----------------------------------------------
# Delay between SIGTERM and process exit, to cover the load balancer's
# asynchronous removal of the instance from rotation.
PRE_STOP_DELAY_SECONDS=5

# --- SLO (ADR-0024) ------------------------------------------------------
# The target for the latency SLO. The same number the README names.
LATENCY_SLO_MS=200

# --- experiments ---------------------------------------------------------
# Kill switch (no deploy needed): set to 1 to treat every experiment as
# stopped for this process. Read at startup; a restart applies a change.
# EXPERIMENT_DISABLED=1

# --- scripts (used by scripts/eval.py; not read by the API) --------------
EVAL_GOLDEN_SET_VERSION=v1

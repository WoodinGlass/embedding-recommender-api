# =============================================================================
# embedding-recommender-api — example configuration
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.
# Every variable here is documented in README.md § Configuration.
# =============================================================================

# --- application ---------------------------------------------------------
APP_ENV=dev                       # dev | staging | prod
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | console

# --- storage: PostgreSQL with pgvector -----------------------------------
# Local docker-compose default. Override for staging/prod.
DATABASE_URL=postgresql://recsys:recsys@postgres:5432/recsys

# --- cache: Redis --------------------------------------------------------
# The cache is optional on the hot path — the service degrades gracefully
# if Redis is unreachable (see docs/decisions.md § 6).
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# --- authentication ------------------------------------------------------
# API_KEYS is a comma-separated allowlist. Rotate by adding the new key
# first, deploying, then removing the old one.
API_KEYS=dev-key-1,dev-key-2
JWT_SECRET=change-me-before-any-real-deployment
JWT_ALGORITHM=HS256
RATE_LIMIT_PER_MINUTE=600

# --- embeddings ----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_ONNX_PATH=artifacts/onnx/all-MiniLM-L6-v2
DEVICE=cpu                        # cpu | cuda

# --- retrieval -----------------------------------------------------------
INDEX_BACKEND=pgvector            # pgvector | faiss
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=100
ANN_TIMEOUT_MS=120                # hard timeout before serving the fallback

# --- experiments ---------------------------------------------------------
# Per-experiment salts should be set explicitly when creating an experiment;
# this is the fallback salt for local development only.
EXPERIMENT_SALT_DEFAULT=recsys-default-v1

# --- observability -------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=recsys-api
METRICS_ENABLED=true
